<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for API 31+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   Only the user's documents (Room DB) and reader preferences (DataStore) are transferred;
   caches and exported files are intentionally excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
