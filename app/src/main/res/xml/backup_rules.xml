<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices older than API 31.
   See https://developer.android.com/guide/topics/data/autobackup
   Only the user's documents (Room DB) and reader preferences (DataStore) are backed up;
   caches and exported files are intentionally excluded.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="file" path="datastore/" />
</full-backup-content>
